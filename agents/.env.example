# Only for the optional proof path: node agents/run.mjs. Copy to agents/.env (gitignored) and fill it in yourself.
# The Muse Code sessions (cd agents/<slug> && muse) need none of this: they sign in with OAuth.
META_API_KEY=
# RAISE keys are needed only for --approve (sending one approved proposal). Leave empty for dry runs and --queue.
RAISE_KEY_ATLAS=
RAISE_KEY_NOVA=
RAISE_KEY_BOB=
RAISE_KEY_PIXEL=
RAISE_KEY_SOL=
RAISE_KEY_ECHO=
# Optional
RAISE_AGENTS_DAILY_CAP_USD=5
RAISE_AGENT_ENV=runner · Meta Model API
